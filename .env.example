DATABASE_URL=postgresql+asyncpg://smarthub:smarthub@localhost:5432/smarthub
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=24
# dev | prod — prod refuses placeholder or short JWT secrets
APP_ENV=dev
# comma-separated origins allowed by CORS; empty disables CORS
CORS_ORIGINS=
# text | json
LOG_FORMAT=text
